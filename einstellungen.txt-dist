 Türsteuerungs-Zugangscodes
[tuer]
zugangs_code   = [  1,  2,  3,  4 ]
herunterfahren = [ 13, 12, 11, 10 ]

# Telegram Benachrichtungs-Einstellungen
[telegram]
TOKEN   = ""
CHAT_ID = ""

# Namen für die einzelnen Klingelschilder
[namen] 
oben  = "Wohnung oben"
mitte = "Wohnung unten"
unten = "Briefkasten öffnen"

# NFC-Tokens zur Türöffnung
[nfc]
tokens = [
	   "deadbeef", # Konrad
           "12345678", # Paul
	 ]

# GPI Pinbelegung
[gpio]
beeper    = 15
backlight = 19


# Screensaver etc.
[screen]
timeout = 20 # Sekunden
